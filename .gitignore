# ============================================================
# Discharge+ — Root .gitignore
# ============================================================

# Environment & secrets (never commit real keys)
.env
.env.*
*.env
!.env.example
!.env.*.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Secret / credential files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials.json
secrets.json
service-account*.json
**/serviceAccountKey.json

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
ENV/
env/
backend/pip_out.txt
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / Frontend build
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & local data
*.sqlite3
*.db

# OS & Editor
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
