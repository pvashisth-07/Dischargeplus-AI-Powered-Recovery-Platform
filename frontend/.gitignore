# Dependencies & build
node_modules/
dist/
dist-ssr/

# Environment & secrets (Vite exposes VITE_* vars to the client)
.env
.env.*
*.env
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
